<!DOCTYPE html>
<html>
<head>
    <title>Daftar Buku</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;400&display=swap" rel="stylesheet">
</head>
<body>
    <div class="container">
        <h1 class="judul-utama">📚 Daftar Buku</h1>
        <a href="/add" class="fab">+</a>
        <input type="text" id="searchBar" placeholder="Cari buku ..." style="margin-bottom:18px;width:310px;max-width:97%;padding:12px 16px;font-size:1.08rem;border-radius:9px;border:1.6px solid #d4d7ff;box-shadow:0 2px 10px #f0f2ff36;">
        <div class="table-wrapper">
            <table class="tabel-buku">
                <thead>
                    <tr>
                        <th>Cover</th>
                        <th>Judul</th>
                        <th>Penulis</th>
                        <th>Tahun</th>
                        <th>Status</th>
                        <th>Peminjam</th>
                        <th>Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (books.length === 0) { %>
                        <tr>
                            <td colspan="7" class="empty-msg">Belum ada data buku.</td>
                        </tr>
                    <% } %>
                    <% books.forEach(book => { %>
                    <tr class="row-3d">
                        <td>
                          <% if (book.cover) { %>
                            <img src="/uploads/<%= book.cover %>" alt="Cover Buku" style="width:54px;box-shadow:0 4px 14px #cadcff70;border-radius:8px;">
                          <% } else { %>
                            <span style="color:#ddd;">(tidak ada)</span>
                          <% } %>
                        </td>
                        <td>
                            <a href="javascript:void(0)" 
                              class="book-detail-link"
                              data-title="<%= book.title.replace(/\"/g, '&quot;') %>"
                              data-author="<%= book.author.replace(/\"/g, '&quot;') %>"
                              data-year="<%= book.year %>"
                              data-cover="<%= book.cover ? '/uploads/' + book.cover : '' %>">
                              <%= book.title %>
                            </a>
                        </td>
                        <td><%= book.author %></td>
                        <td><%= book.year %></td>
                        <td>
                          <span class="badge <%= book.status === 'Tersedia' ? 'badge-available' : 'badge-borrowed' %>">
                            <%= book.status %>
                          </span>
                        </td>
                        <td>
                          <% if (book.status === 'Dipinjam' && book.borrower && book.borrower.name) { %>
                            <b><%= book.borrower.name %></b><br>NIM: <%= book.borrower.nim %>
                          <% } else { %>
                            -
                          <% } %>
                        </td>
                        <td>
                          <% if (book.status === 'Tersedia') { %>
                            <button type="button" class="btn pinjam" onclick="showBorrowForm('<%= book._id %>', '<%= encodeURIComponent(book.title) %>')">Pinjam</button>

                          <% } else { %>
                            <form action="/return/<%= book._id %>" method="POST" style="display:inline;">
                                <button class="btn kembalikan" type="submit">Kembalikan</button>
                            </form>
                          <% } %>
                          <a href="/edit/<%= book._id %>" class="btn edit">Edit</a>
                          <a href="/delete/<%= book._id %>" onclick="return confirm('Yakin hapus?')" class="btn delete">Hapus</a>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal detail buku -->
    <div id="detailModal" style="display:none;position:fixed;top:0;left:0;width:100vw;height:100vh;background:rgba(40,42,86,0.18);z-index:1000;align-items:center;justify-content:center;">
      <div id="modalContent" style="background:#fff;border-radius:18px;box-shadow:0 8px 30px #6c63ff48;padding:38px;min-width:290px;max-width:94vw;max-height:95vh;overflow:auto;position:relative;">
        <button onclick="closeModal()" style="position:absolute;top:13px;right:13px;background:#f5f5ff;border:none;border-radius:50%;width:35px;height:35px;font-size:1.4rem;color:#6c63ff;cursor:pointer;">&times;</button>
        <div id="modalBody"></div>
      </div>
    </div>

    <!-- Modal Pinjam Buku -->
    <div id="borrowModal" style="display:none;position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:2000;align-items:center;justify-content:center;background:rgba(0,0,0,0.14)">
      <div style="background:#fff;border-radius:16px;max-width:340px;padding:32px 24px 28px 24px;box-shadow:0 4px 24px #cadcff70;position:relative;">
        <button onclick="closeBorrowModal()" style="position:absolute;top:12px;right:12px;border:none;background:#f5f5ff;border-radius:50%;width:32px;height:32px;font-size:1.18rem;color:#6c63ff;">&times;</button>
        <h3 id="borrowTitle" style="margin:0 0 20px 0;font-weight:700;font-size:1.2rem;color:#372982;">Pinjam Buku</h3>
        <form id="borrowForm" method="POST">
          <input type="hidden" name="id" id="borrowId">
          <div class="input-group">
            <label>Nama</label>
            <input type="text" name="name" required>
          </div>
          <div class="input-group">
            <label>NIM</label>
            <input type="text" name="nim" required>
          </div>
          <button class="btn-primary" type="submit" style="width:100%;margin-top:14px;">Simpan Peminjaman</button>
        </form>
      </div>
    </div>

    <script>
    // Live search/filter
    document.getElementById('searchBar').addEventListener('keyup', function() {
        let q = this.value.toLowerCase();
        document.querySelectorAll('.row-3d').forEach(function(row){
            let text = row.innerText.toLowerCase();
            row.style.display = text.indexOf(q) > -1 ? '' : 'none';
        });
    });

    // Modal detail buku
    document.querySelectorAll('.book-detail-link').forEach(function(link){
      link.addEventListener('click', function(){
        const title = this.dataset.title;
        const author = this.dataset.author;
        const year = this.dataset.year;
        const cover = this.dataset.cover;
        showDetail(title, author, year, cover);
      });
    });

    function showDetail(title, author, year, cover) {
      let html = `<h2 style='margin-top:2px;'>${title}</h2>
        <div style="margin-bottom:20px;"><b>Penulis:</b> ${author}<br><b>Tahun:</b> ${year}</div>`;
      if(cover && cover !== '') html += `<img src="${cover}" alt="Cover" style="max-width:150px;max-height:200px;border-radius:10px;box-shadow:0 4px 22px #cfd2ff50;">`;
      document.getElementById('modalBody').innerHTML = html;
      document.getElementById('detailModal').style.display = 'flex';
    }
    function closeModal() {
      document.getElementById('detailModal').style.display = 'none';
    }

    // Modal Pinjam Buku
    function showBorrowForm(bookId, bookTitle) {
    // Decode the book title if needed
    bookTitle = decodeURIComponent(bookTitle);
    document.getElementById('borrowModal').style.display = 'flex';
    document.getElementById('borrowId').value = bookId;
    document.getElementById('borrowTitle').innerText = 'Pinjam: ' + bookTitle;
    document.getElementById('borrowForm').action = '/borrow/' + bookId;
}

    function closeBorrowModal() {
      document.getElementById('borrowModal').style.display = 'none';
    }
    </script>
</body>
</html>
